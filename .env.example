# ─── Harness API Keys ────────────────────────────────────────────────────────
# Fill ONLY the harnesses you use. Leave others empty.

# Claude Code (Anthropic)
CLAUDE_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# AntiGravity (Google)
AGY_API_KEY=your_google_key_here
AGY_MODEL=gemini-2.5-pro

# Codex (OpenAI) — coming soon
CODEX_API_KEY=your_openai_key_here
CODEX_MODEL=gpt-4o

# Hermes (Nous Research / Ollama) — coming soon
HERMES_BASE_URL=http://localhost:11434
HERMES_MODEL=hermes3

# ─── Optional: API Gateway / Proxy ───────────────────────────────────────────
# Point all traffic through a single gateway (LiteLLM, 9Router, etc.)
# If set, overrides per-harness base URLs.
GATEWAY_ENABLED=false
GATEWAY_BASE_URL=http://localhost:4000/v1
GATEWAY_API_KEY=your_gateway_key_here

# ─── Server Settings ─────────────────────────────────────────────────────────
HOST=localhost
PORT=8000
DEBUG=false

# ─── Memory / Context ────────────────────────────────────────────────────────
DB_PATH=./data/history.db
MAX_HISTORY_MESSAGES=100
