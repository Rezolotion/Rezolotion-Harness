# ─── Harness API Keys ────────────────────────────────────────────────────────
# Fill ONLY the harnesses you use. Leave others empty.

# Claude Code (Anthropic)
CLAUDE_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# AntiGravity (Google)
AGY_API_KEY=your_google_key_here
AGY_MODEL=gemini-2.5-pro

# Codex / ChatGPT (OpenAI)
OPENAI_API_KEY=your_openai_key_here
CODEX_API_KEY=your_openai_key_here
CODEX_MODEL=gpt-4o

# DeepSeek AI (R1 & V3)
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-reasoner

# OpenRouter (Unified Open Weights)
OPENROUTER_API_KEY=your_openrouter_key_here

# Hermes (Nous Research / Ollama)
HERMES_BASE_URL=http://localhost:11434
HERMES_MODEL=hermes-3-llama-3.1-8b

# ─── Optional: 9Router Local Gateway ───────────────────────────────────────────
NINE_ROUTER_URL=http://localhost:20128
NINE_ROUTER_API_KEY=your_9router_api_key_here


# ─── Server Settings ─────────────────────────────────────────────────────────
HOST=localhost
PORT=8000
DEBUG=false

# ─── Memory / Context ────────────────────────────────────────────────────────
DB_PATH=./data/history.db
MAX_HISTORY_MESSAGES=100
